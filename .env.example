# Mail provider (mail.tm compatible)
ZT_MAIL_BASE_URL=https://api.mail.tm
ZT_MAIL_DOMAIN=

# ZeroTwo onboarding
ZT_NAME=Burz
ZT_INTEREST=Just exploring

# Browser (choose one)
# a) local Chromium launched with --remote-debugging-port
ZT_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<id>
# b) Browser Use cloud browser HTTP endpoint
ZT_CDP_URL=

# 9Router
NINEROUTER_URL=http://localhost:20128
NINEROUTER_API_KEY=sk_9router
ZT_SHIM_BASE_URL=http://localhost:8787/v1

ZT_BROWSER_MODE=cdp
ZT_CONCURRENCY=1

# Proxy pool (host:port:user:pass, newline or comma separated)
ZT_PROXIES=
# ZT_PROXY_FILE=/path/to/proxies.txt
ZT_PROXY_SCHEME=http
ZT_PROXY_STICKY=1
